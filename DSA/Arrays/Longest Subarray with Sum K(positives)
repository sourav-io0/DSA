class Solution:
    def longestSubarray(self, nums, k):
        max_length=0

        for i in range (len(nums)):
            current_sum=0
            for j in range (i,len(nums)):
                current_sum+=nums[j]

                if current_sum==k:
                    length=j-1+1
                    max_length=max(max_length,length)
